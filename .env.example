# Copy to .env and fill in. Never commit .env.
NVIDIA_API_KEY=nvapi-your-key-here
# Tried in order; put what check_models.py says works first
# LLM_MODELS=nvidia/nemotron-3-super-120b-a12b,google/gemma-4-31b-it,qwen/qwen3.5-397b-a17b,meta/llama-3.3-70b-instruct
# VISION_MODELS=google/gemma-4-31b-it,qwen/qwen3.5-397b-a17b,nvidia/nemotron-nano-12b-v2-vl
# ASR_MODEL=large-v3-turbo
SHOP_NAME="Chioma Stores"

# Voice replies for traders who can't read (tts.py). Spitch = Nigerian TTS: English, Pidgin, Yoruba, Hausa, Igbo.
# pip install spitch   then get a key at https://spitch.app (new accounts get free credit)
# SPITCH_API_KEY=
# TTS_BACKEND=spitch     # or mms (offline Meta MMS, demo-only licence) or off
# TTS_SPEED=0.95         # 1.0 = normal; pick with: python eval/tts_check.py --audition
# TTS_VOICE_PIDGIN=ufoma # per-language voice override (TTS_VOICE_YORUBA, _HAUSA, _IGBO, _ENGLISH)

# WhatsApp Cloud API (docs/WHATSAPP.md)
# WHATSAPP_TOKEN=               # permanent system-user token (or a fresh temporary one)
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=        # any random string; same value in Meta's webhook settings
# SHOP_PHONE=2348000000000      # which trader's book the web dashboard shows

# Backup AI on our Brev GPU (vLLM / NIM, OpenAI-compatible), tried after the cloud models. See README "Run on NVIDIA Brev".
# LOCAL_LLM_URL=http://localhost:8001/v1
# LOCAL_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
# LLM_COOLDOWN=120        # skip a model this many seconds after it times out

# Speech-to-text engine: local (Whisper/omniASR on our GPU, Spitch as fallback) | spitch (Spitch first) |
# spitch-local (Spitch for Yoruba/Hausa/Igbo, Whisper for English/Pidgin). Needs SPITCH_API_KEY for Spitch.
# ASR_ENGINE=local

# Country pack (currency, languages, local terms): NG (default) | KE | SN | CI | MA | DZ | TN | SA. See country.py.
# COUNTRY=NG
