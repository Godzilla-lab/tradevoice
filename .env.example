# Copy to .env and fill in. Never commit .env.

# N-ATLaS: the main brain (deploy/modal_natlas.py prints the URL; add /v1). Tried before every other model.
# NATLAS_URL=https://<your-modal-workspace>--tradevoice-natlas-serve.modal.run/v1
# NATLAS_KEY=                # same value as in: modal secret create natlas NATLAS_KEY=...
# NATLAS_MODEL=natlas        # served name on the vLLM server
# NATLAS_TIMEOUT=20          # seconds before the backups answer (a sleeping GPU needs 1-3 min to wake)
# NATLAS_TEMPERATURE=0.1     # model card settings
# NATLAS_REPETITION_PENALTY=1.12
# NATLAS_ASR_URL=https://<your-modal-workspace>--tradevoice-natlas-asr-asr-web.modal.run   # deploy/modal_asr.py
#   N-ATLaS speech models; voice notes are heard by N-ATLaS ONLY (Intron/Spitch keys below are for comparison tests)
# Speech fixes (on by default; the team A/B tests them with scripts/speech_ab.py, 0 turns one off):
# NATLAS_ASR_PREP=1        light audio prep on the hearing server (cut quiet ends, level the volume; no denoising)
# NATLAS_ASR_MERGE=1       Yoruba / Hausa / Igbo notes are also heard by the English model; N-ATLaS merges the two
# NATLAS_MERGE_TIMEOUT=8   seconds to wait for that merge, then the language model's words are used
# NATLAS_WATCH=1            # 1 = keep N-ATLaS awake in market hours (pilot days, about $10/day on Modal); 0 = it sleeps after an hour
# NATLAS_WATCH_HOURS=7-20    # Nigeria time: ping every 10 min (keeps the GPU warm) and alert the team if it is down
# ADMIN_TOKEN=               # long random string: opens /team?key=... (team dashboard + anonymised CSV). Never share.
# TEAM_WHATSAPP=             # team numbers for alerts, comma-separated (never traders' customers)
# TEAM_PHONES=               # team phone numbers, comma between: their testing is left out of the NAIC numbers (/team)
# PRIVACY_CONTACT=           # email for privacy requests, shown on /privacy (a team address, never a personal phone)
# WhatsApp templates (needed for messages to traders who haven't written to the bot in 24 hours: login codes,
# daily summaries, paid notices, team alerts). Make them: deploy/server/whatsapp_templates.sh --print / --create,
# then set each APPROVED name. Without them, codes still work: the trader taps 'Send it on WhatsApp' (LOGIN <word>).
# WHATSAPP_WABA_ID=            # WhatsApp Business Account ID (only to create templates by API)
# WHATSAPP_TPL_CODE=tradevoice_code
# WHATSAPP_TPL_SUMMARY=tradevoice_daily
# WHATSAPP_TPL_PAID=tradevoice_paid
# WHATSAPP_TPL_ALERT=tradevoice_alert
# WHATSAPP_TPL_LANG=en
# WHATSAPP_FLOOD_MAX=30         # messages a minute from one number before the rest are ignored
# TRAIN_DIR=                 # where voice notes, photos, live talk and chats of traders who said yes to helping improve
#                             TradeVoice are kept (default: a 'training' folder next to the books). Team only, via /team
# TRAIN_MIN_FREE_GB=3         # below this much free disk, no new audio or photos are kept (the books always save)
# DELETE_DAYS=90             # a deleted account is kept this many days (log in to keep it), then erased for good
NVIDIA_API_KEY=nvapi-your-key-here
# Tried in order; put what check_models.py says works first
# LLM_MODELS=nvidia/nemotron-3-super-120b-a12b,google/gemma-4-31b-it,qwen/qwen3.5-397b-a17b,meta/llama-3.3-70b-instruct
# VISION_MODELS=google/gemma-4-31b-it,qwen/qwen3.5-397b-a17b,nvidia/nemotron-nano-12b-v2-vl
# ASR_MODEL=large-v3-turbo
SHOP_NAME="Chioma Stores"

# Voice replies (tts.py): Intron ONLY (INTRON_API_KEY below). No voice / no credit -> replies are text.
# VOICE_REPLIES=voice      # WhatsApp: speak back only after a voice note (saves credit) | always

# The public address (the live server's setup fills it in): pay links, lender links, the bot's "dashboard" link
# PUBLIC_URL=https://NAME.duckdns.org

# WhatsApp Cloud API (docs/WHATSAPP.md). Sign-up codes go by WhatsApp: no WhatsApp = no sign-up on the live server.
# WHATSAPP_TOKEN=               # permanent system-user token (or a fresh temporary one)
# WHATSAPP_PHONE_ID=            # (WHATSAPP_PHONE_NUMBER_ID also works)
# WHATSAPP_BOT_NUMBER=          # the bot's number, digits only: the website's "Use on WhatsApp" buttons
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=        # any random string; same value in Meta's webhook settings

# Backup AI on our Brev GPU (vLLM / NIM, OpenAI-compatible), tried after the cloud models. See README "Run on NVIDIA Brev".
# LOCAL_LLM_URL=http://localhost:8001/v1
# LOCAL_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
# LLM_COOLDOWN=120        # skip a model this many seconds after it times out

# Speech-to-text: N-ATLaS (NATLAS_ASR_URL above) is the ONLY engine the app uses. Intron/Spitch hearing is for
# comparison tests only: python eval/run_eval.py --audio eval/audio --asr natlas|intron|spitch
# SPITCH_API_KEY=          # comparison tests only (pip install spitch)
# INTRON_API_KEY=          # voice.intron.io → Developers. Never commit or paste it. Voice replies + comparison tests.
# TTS_BACKEND=intron       # voice replies: intron | off
# INTRON_GENDER=female     # Intron voice: female | male
# INTRON_ACCENT_YORUBA=yoruba   # override an accent if Intron rejects it (also _HAUSA, _IGBO, _ENGLISH, _PIDGIN)
# INTRON_ENGLISH_VOICE=pcm     # English replies in Intron's Nigerian Pidgin voice (default); en = an accented English voice
# INTRON_EN_CODE=pcm       # Intron code for English/Pidgin notes: pcm or en (test both!)
# Live talk (the orb) hears and speaks with Intron's STREAMING APIs (src/intron_live.py): the words come back while
# the trader talks, the reply's voice plays piece by piece. N-ATLaS + our code stay the brain. Needs INTRON_API_KEY.
# LIVE_HEARING=intron      # natlas = the old way (Whisper on Modal, whole recording after you stop)
# INTRON_STT_ENGLISH=pcm   # Intron's model for English/Pidgin talk: pcm (Pidgin-English mixed) or en
# LIVE_FAST_RECORDS=1      # live talk: a record the rules read fully is answered at once (no ~5 s N-ATLaS wait)
# ASK_AI_SECONDS=20        # one chat or live turn waits at most this long for N-ATLaS, then the rules answer
# LIST_AI_SECONDS=90       # a pasted list: N-ATLaS gets longer to write every line
# The Ask chat's brain (src/agent.py): a real model with the book's tools; code checks every number it says.
# Needs NVIDIA_API_KEY (build.nvidia.com) for the NVIDIA models; N-ATLaS is the backup (first in Yoruba/Hausa/Igbo).
# ASK_BRAIN=llm            # rules = the old way (no model in the Ask chat)
# ASK_MODELS=nvidia/nemotron-3-super-120b-a12b,google/gemma-4-31b-it
# ASK_LLM_SECONDS=45       # the model's time for one Ask message (tools included), then the rules answer
# ANSWER_WAIT_SECONDS=25   # longer work answers in the background (the page collects it; Safari stops at 60 s)
# VISION_DEADLINE=90       # a photo: the vision models' total time

# Paystack (customers pay a reminder's pay link by card, transfer, USSD or bank; the debt settles by itself and the
# trader gets a WhatsApp). Use TEST keys (sk_test_...) until the business is verified. Never commit or paste keys.
# In the Paystack dashboard → Settings → API Keys & Webhooks, set the webhook URL to https://<your-public-link>/paystack/webhook
# PAYSTACK_SECRET_KEY=sk_test_your-key-here
# PAYSTACK_EMAIL=payments@your-domain    # Paystack needs an email on each payment; customers don't give one

# Login codes on screen instead of WhatsApp: ONLY for internal tests with made-up numbers on your own computer.
# Never on the live server (anyone could open any book); the server ignores it anyway (TV_PUBLIC=1).
# AUTH_DEMO=1

# Backups (scripts/backup.py, hourly on the live server): a copy off the server. Azure Blob Storage container SAS URL
# (Create + Write only) or an Oracle pre-authenticated request URL. Treat it like a password. docs/HOSTING.md step 7.
# BACKUP_UPLOAD_URL=
# Or Supabase Storage (free, no card; docs/HOSTING_AWS.md step 5): a project only for backups, private bucket "backups"
# BACKUP_SUPABASE_URL=https://PROJECT.supabase.co
# BACKUP_SUPABASE_KEY=          # the project's secret key: treat it like a password
# BACKUP_SUPABASE_BUCKET=backups
# Or a folder that also gets each backup (e.g. a mounted drive)
# BACKUP_COPY_DIR=
